{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend (Flask)",
      "type": "shell",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "args": ["app.py"],
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Frontend (Vite)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Full Stack (NexusIQ)",
      "dependsOn": ["Start Backend (Flask)", "Start Frontend (Vite)"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Backend Tests (Pytest)",
      "type": "shell",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "args": ["-m", "pytest", "backend\\tests\\test_core.py", "-v"],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
